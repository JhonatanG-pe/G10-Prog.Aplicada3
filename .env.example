# Copia este archivo como ".env" (en la misma carpeta) y completa los valores.
# Los datos de conexión a la base de datos te los pasa Ricardo por mensaje privado.
# NUNCA compartas tu archivo .env ni lo subas a internet: contiene contraseñas.

# --- Base de datos SQL Server (hosting) ---
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Driver ODBC instalado en tu PC. Si lo dejas vacío se usa "ODBC Driver 17 for SQL Server".
# Si tienes el 18, escribe: DB_DRIVER=ODBC Driver 18 for SQL Server
DB_DRIVER=

# --- Flask ---
# Clave secreta para las sesiones: cualquier texto largo y aleatorio. Para generar una:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Pon 1 SOLO en tu PC de desarrollo (recarga automática al cambiar código).
# Nunca en el servidor público.
FLASK_DEBUG=

# --- Fotos de productos en el hosting (SmarterASP) ---
# Las fotos se suben por FTP a la carpeta "Fotos" del sitio web; así todas las PC las ven.
# Usuario y contraseña FTP te los pasa Ricardo por mensaje privado.
FTP_SERVIDOR=
FTP_USUARIO=
FTP_CLAVE=
# Carpeta de las fotos vista desde el FTP y la MISMA carpeta vista desde internet:
FTP_CARPETA=/site16/Fotos
FOTOS_URL_PUBLICA=http://ricardofrisancho-001-site16.ltempurl.com/Fotos

# --- Facturación electrónica SUNAT (boletas y facturas) ---
# Si se dejan vacíos, se usa el entorno de PRUEBAS (beta) de SUNAT: RUC 20000000001,
# usuario MODDATOS / moddatos y el certificado de prueba (python generar_certificado_prueba.py).
# Los comprobantes de beta NO tienen validez tributaria.
SUNAT_URL=
SUNAT_USUARIO_SOL=
SUNAT_CLAVE_SOL=
# Ruta del certificado digital: .pem (clave + certificado) o .pfx/.p12 con su contraseña.
SUNAT_CERTIFICADO=
SUNAT_CERTIFICADO_CLAVE=
# 1 (o vacío) = enviar a SUNAT al confirmar la compra; 0 = dejar pendiente y enviar desde el panel.
SUNAT_ENVIO_AUTOMATICO=
# Carpeta donde se guardan los PDF de boletas y facturas. Vacío = carpeta "comprobantes" del proyecto.
SUNAT_CARPETA_PDF=
